# Copie para .env e preencha. Nunca commite o .env.

# Origem dos dados: mock | rest
GLPI_ADAPTER=mock

# Fase 2 (adapter rest)
GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# IA via LiteLLM
LLM_MODEL=anthropic/claude-opus-5-5
# Opcional: modelo usado se o principal der timeout/5xx (ex.: anthropic/claude-sonnet-5-5)
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SEGUNDOS=30
ANTHROPIC_API_KEY=
